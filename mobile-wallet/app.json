{
  "expo": {
    "name": "Personal Wallet Command",
    "slug": "personal-wallet-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#07080f"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#07080f"
      },
      "package": "com.portfolio.personalwallet"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
